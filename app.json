{
  "expo": {
    "name": "Connect",
    "slug": "connect-app",
    "scheme": "connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#171D1B",
          "sounds": []
        }
      ],
      "expo-video"
    ],
    "android": {
      "package": "com.daiso.connect",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171D1B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.daiso.connect",
      "supportsTablet": false
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
