{
  "expo": {
    "name": "Connect",
    "slug": "connect-app",
    "scheme": "connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "plugins": [
      "expo-router",
      ["expo-notifications", { "color": "#1AB64A" }]
    ],
    "android": {
      "package": "com.daiso.connect",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#171D1B"
      }
    },
    "ios": {
      "bundleIdentifier": "com.daiso.connect",
      "supportsTablet": false
    },
    "experiments": {
      "typedRoutes": true
    }
  }
}
